{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "plugins": [
    "@azumag/opencode-rate-limit-fallback@2.1.1"
  ],
  "providers": {
    "opencode": {
      "models": {
        "big-pickle": {
          "name": "Big Pickle — default, free, reliable tool use (repo skills/AGENTS.md)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "nemotron-3.5-super-vl-free": {
          "name": "Nemotron 3.5 Super VL Free",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "ollama": {
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B — LOCAL, no API key. Opt-in via /model or `unlimited`; small model can loop on tools",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B — LOCAL, unlimited, code/tool focus",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B — LOCAL, unlimited, strong tool use",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen2.5vl:3b": {
          "name": "Qwen 2.5 VL 3B — LOCAL vision, unlimited (no tools)",
          "capabilities": {
            "tools": false,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "kilo": {
      "name": "Kilo Code — free gateway, NO API key needed (200 req/hr per IP)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.kilo.ai/api/gateway",
        "apiKey": ""
      },
      "models": {
        "kilo-auto/free": {
          "name": "Kilo auto/free — free-pool router (verified: tools + chat)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "nvidia/nemotron-3.5-super-vl:free": {
          "name": "Nemotron 3.5 Super VL free — 1M context, text + image",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B free — 1M context, text",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "openrouter/free": {
          "name": "OpenRouter free router via Kilo",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
