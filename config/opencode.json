{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3.5-super-vl-free",
  "plugins": [
    "@azumag/opencode-rate-limit-fallback@2.1.1"
  ],
  "providers": {
    "opencode": {
      "models": {
        "nemotron-3.5-super-vl-free": {
          "name": "Nemotron 3.5 Super VL Free",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "google": {
      "env": [
        "GEMINI_API_KEY"
      ],
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-flash-latest": {
          "name": "Gemini Flash (fallback 1)"
        }
      }
    },
    "groq": {
      "env": [
        "GROQ_API_KEY"
      ],
      "settings": {
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "Groq GPT-OSS 120B (fallback 2)"
        }
      }
    },
    "ollama": {
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B — LOCAL, unlimited, no API key",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B — LOCAL, unlimited, code/tool focus",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B — LOCAL, unlimited, strong tool use",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen2.5vl:3b": {
          "name": "Qwen 2.5 VL 3B — LOCAL vision, unlimited",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
