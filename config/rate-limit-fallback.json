{
  "enabled": true,
  "fallbackMode": "cycle",
  "cooldownMs": 3600000,
  "fallbackModels": [
    { "providerID": "opencode", "modelID": "nemotron-3.5-super-vl-free" },
    { "providerID": "google", "modelID": "gemini-flash-latest" },
    { "providerID": "groq", "modelID": "openai/gpt-oss-120b" }
  ],
  "errorPatterns": {
    "custom": [
      {
        "name": "free-limit-reached",
        "priority": 100,
        "patterns": ["free limit reached", "free.?limit", "usage limit"]
      }
    ],
    "ignorePatterns": ["not your plan limits", "draw from your extra usage"]
  },
  "retryPolicy": {
    "strategy": "immediate"
  },
  "configReload": {
    "enabled": true,
    "watchFile": true,
    "debounceMs": 1000,
    "notifyOnReload": true
  }
}
